# Copy this file to .env for local development, and set these in Netlify Site Settings -> Environment Variables.
# Required: 6-digit PIN for Hassan to unlock the scrapbook.
BIRTHDAY_PASSWORD=000000

# Recommended: Random 32+ character secret used to sign session cookies.
# If omitted, a key is derived from BIRTHDAY_PASSWORD via HMAC.
SESSION_SECRET=replace-with-a-long-random-secret-string

